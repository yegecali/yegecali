    "aos": "^2.3.4",
    "particles.js": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/aos": "^3.0.8",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.107.1",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
